    "@renderweld/server": "workspace:*",
    "@types/node": "^22.10.0",
    "axe-core": "4.14.0",
    "esbuild": "0.25.12",
    "playwright": "1.63.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
