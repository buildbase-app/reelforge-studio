{
  "name": "reelforge-studio",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "ReelForge: self-hosted, AI-assisted short-form video studio (Remotion + Motion Canvas).",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "typecheck": "tsc -p tsconfig.json && pnpm -r run typecheck",
    "test": "pnpm -r run test && pnpm test:docs && pnpm test:capture && pnpm test:load && pnpm test:dev",
    "spike": "tsx scripts/spike.ts",
    "gallery": "tsx scripts/gallery/src/cli.ts",
    "prebuild:engines": "tsx apps/server/src/prebuild.ts",
    "check": "pnpm typecheck && pnpm test",
    "dev:setup": "node scripts/dev/setup.mjs",
    "setup": "node scripts/dev/setup.mjs",
    "dev:all": "node scripts/dev/dev-all.mjs",
    "test:dev": "vitest run --dir scripts/dev",
    "dev": "REELFORGE_LICENCE_MODE=${REELFORGE_LICENCE_MODE:-off} REELFORGE_LOGS_EXPORTER=${REELFORGE_LOGS_EXPORTER:-pretty} tsx watch --clear-screen=false apps/server/src/main.ts",
    "start": "tsx apps/server/src/main.ts",
    "keys:create": "tsx apps/server/src/cli.ts keys create",
    "renderweld": "tsx apps/server/src/cli.ts",
    "reelforge": "tsx apps/server/src/reelforge.ts",
    "docs:config": "tsx scripts/config-docs.ts",
    "docs:reference": "tsx scripts/docs/reference.ts",
    "docs:sync": "node scripts/docs/sync-buildbase.mjs",
    "test:docs": "node --test scripts/docs/*.test.mjs",
    "tutorials:prove": "tsx scripts/tutorials/prove.ts",
    "tutorials:docs": "tsx scripts/tutorials/docs.ts",
    "tutorials:test": "vitest run --dir scripts/tutorials",
    "capture": "node scripts/capture/capture.mjs",
    "test:capture": "node --test scripts/capture/*.test.mjs",
    "load": "node --import tsx scripts/load/run.ts",
    "load:smoke": "LOAD_PROFILE=smoke node --import tsx scripts/load/run.ts",
    "load:depth": "node --import tsx scripts/load/queue-depth.ts",
    "load:encode": "node --import tsx scripts/load/encode.ts",
    "load:real": "node --import tsx scripts/load/real-render.ts",
    "test:load": "vitest run --dir scripts/load",
    "formats:prove": "tsx scripts/formats/prove.ts",
    "formats:prove-layouts": "tsx scripts/formats/prove-layouts.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12",
    "@renderweld/project-schema": "workspace:*",
    "@renderweld/media-pipeline": "workspace:*",
    "@renderweld/engine-motion-canvas": "workspace:*",
    "@renderweld/engine-remotion": "workspace:*",
    "@renderweld/core": "workspace:*",
    "@renderweld/server": "workspace:*",
    "@renderweld/engine-html": "workspace:*",
    "@renderweld/engine-hyperframes": "workspace:*",
    "@renderweld/db": "workspace:*",
    "@renderweld/gallery": "workspace:*",
    "zod": "^4.1.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "playwright": "1.63.0",
    "autocannon": "8.0.0",
    "@types/autocannon": "7.12.7",
    "hygen": "6.2.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@remotion/compositor-linux-x64-gnu",
      "better-sqlite3",
      "esbuild"
    ],
    "overrides": {
      "hyperid>uuid": "^11.1.1"
    }
  }
}
