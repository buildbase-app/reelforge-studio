# TLS in front of RenderWeld (automatic Let's Encrypt certificates).
# Set RENDERWELD_PUBLIC_URL=https://$RENDERWELD_DOMAIN on the renderweld service
# so /mcp accepts this host name and output links use it.
{$RENDERWELD_DOMAIN} {
	encode zstd gzip
	# Large uploads and long SSE streams.
	request_body {
		max_size 250MB
	}
	reverse_proxy renderweld:4321 {
		flush_interval -1
	}
}
