# PgBouncer settings for ReelForge (issue #152, D-104), read by the image's entrypoint
# (edoburu/pgbouncer writes pgbouncer.ini from them). Used by docker-compose.pgbouncer.yml
# and by the Docker scale e2e (POOLER=pgbouncer e2e/docker/scale.sh), so both run the same pooler.
# DB_HOST, DB_USER and DB_PASSWORD are set by whoever starts it (never stored here).
LISTEN_PORT=6432
AUTH_TYPE=scram-sha-256
# Transaction mode: a server connection is held only for the length of a transaction.
POOL_MODE=transaction
# Server connections per database/user pair: what PostgreSQL actually sees (about 2-4 x its vCPUs).
DEFAULT_POOL_SIZE=20
# Client connections PgBouncer accepts: api instances x connection_limit + workers x their pool.
MAX_CLIENT_CONN=2000
# Prisma's pg adapter uses protocol-level prepared statements; 0 also worked in #151, 200 is what was measured.
MAX_PREPARED_STATEMENTS=200
# extra_float_digits: sent by some clients. options: ReelForge sends `-c search_path=...` only with ?schema=;
# PgBouncer 1.26.1 accepted it in #151, so it is not ignored here (ignoring it would drop the schema).
IGNORE_STARTUP_PARAMETERS=extra_float_digits
