# RenderWeld settings. Copy this file to .env (cp .env.example .env), then add
# the two secrets as the quick start shows. Keep a copy of .env somewhere safe:
# without RENDERWELD_SECRET_KEY a backup cannot be restored.

# Your licence key, from your order page or your account.
RENDERWELD_LICENCE_KEY=

# Optional. Uncomment and change a line to use it.
# RENDERWELD_PORT=4321                      # port on this machine
# RENDERWELD_PUBLIC_URL=https://video.example.com   # when people reach it through a domain with HTTPS
# RENDERWELD_RENDER_CONCURRENCY=1           # videos rendered at once; set it to your number of CPUs
# RENDERWELD_DASHBOARD_ENABLED=false        # the web dashboard at /dashboard
# RENDERWELD_CHROMIUM_NO_SANDBOX=0          # 1 on hosts that block the browser sandbox
# DATABASE_URL=                             # PostgreSQL or MySQL; empty means the built-in SQLite file
