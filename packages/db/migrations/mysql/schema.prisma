  @@index([workspaceId, createdAt])
  @@index([workspaceId, projectId])
  @@index([status])
  @@index([workspaceId, apiKeyId, createdAt])
  @@index([workspaceId, queue, status, createdAt])
  @@index([status, leaseExpiresAt])
}

/// Status changes and log lines of a job, in order (id is monotonic).
model JobEvent {
  id          Int      @id @default(autoincrement())
  workspaceId String   @db.VarChar(191)
  jobId       String   @db.VarChar(191)
  at          DateTime
  /// "status" (message = new status) or "log" (message = the line)
  type        String   @db.VarChar(191)
  message     String   @db.LongText

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, id])
}

/// Operator/agent themes (built-in themes live in code).
model Theme {
  workspaceId String   @db.VarChar(191)
  id          String   @db.VarChar(191)
