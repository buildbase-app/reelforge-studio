// GENERATED from prisma/base.prisma for sqlite. Do not edit; run `pnpm --filter @renderweld/db schemas`.
generator client {
  provider     = "prisma-client"
  output       = "../../src/generated/sqlite"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "sqlite"
}

/// A tenant of the install (#304, D-124): every project, asset, theme, job, key, webhook and audit entry belongs to
/// one. "default" always exists; existing installs keep all their rows there.
model Workspace {
  id        String   @id
  name      String
  createdAt DateTime @default(now())
  /// "active" | "suspended" (keys are refused, queued jobs wait) | "deleted" (soft-deleted, purged after purgeAfter).
  status      String    @default("active")
  updatedAt   DateTime?
  suspendedAt DateTime?
  deletedAt   DateTime?
  /// A soft-deleted workspace's rows and files are purged after this time (workspaces.deleteGraceDays).
  purgeAfter  DateTime?
  /// Per-workspace limits as JSON text (renders per day/month, requests per minute, storage bytes); null: the
  /// workspaces.defaultLimits settings, which are unlimited unless the operator sets them.
  limits      String?

  projects         Project[]
  apiKeys          ApiKey[]
  jobs             Job[]
  themes           Theme[]
  providerSettings ProviderSetting[]
  settings         Setting[]
  assets           Asset[]
  auditLogs        AuditLog[]
  licenceStates    LicenceState[]
  idempotencyKeys  IdempotencyKey[]
  webhookEndpoints WebhookEndpoint[]
  webhookDeliveries WebhookDelivery[]
  webhookAttempts  WebhookAttempt[]
  rateLimitWindows RateLimitWindow[]
  dispatchOutbox   DispatchOutbox[]
  instanceLeases   InstanceLease[]
}

/// A project; its manifests live in ProjectVersion (one row per saved version).
model Project {
  workspaceId String
  id          String
  /// Current version; bumped in the same transaction that inserts the ProjectVersion.
  version     Int
  title       String
  /// List summary of the current version (list_projects without manifests, D-102); null on rows saved before 0008.
  sceneCount      Int?
  durationSeconds Float?
  createdAt   DateTime
  updatedAt   DateTime

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions  ProjectVersion[]

  @@id([workspaceId, id])
  @@index([workspaceId, updatedAt])
  /// Keyset pages of list_projects (D-102).
  @@index([workspaceId, createdAt, id])
}

model ProjectVersion {
  workspaceId String
  projectId   String
  version     Int
  /// The manifest (latest schema version) as JSON text.
  manifest    String
  createdAt   DateTime

  project Project @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade)

  @@id([workspaceId, projectId, version])
}

/// API keys: salted SHA-256 hashes only; the key itself is never stored.
/// Lifecycle (#65, D-055): optional expiry, rotation with a grace window for
/// the previous secret, revocation (the row stays for the audit trail),
/// per-key rate limit, render quotas and IP allowlist.
model ApiKey {
  id                 String    @id
  workspaceId        String
  name               String
  /// JSON array of scopes.
  scopes             String
  /// First characters of the key (lookup index; not secret on its own).
  prefix             String
  salt               String
  hash               String
  createdAt          DateTime
  lastUsedAt         DateTime?
  /// The key stops working after this time (null: never expires).
  expiresAt          DateTime?
  /// Revoked keys never authenticate again; the row stays for the audit trail.
  revokedAt          DateTime?
  /// The secret before the last rotation: prefix, salt and hash, valid until prevExpiresAt.
  prevPrefix         String?
  prevSalt           String?
  prevHash           String?
  prevExpiresAt      DateTime?
  rotatedAt          DateTime?
  /// Requests per minute for this key (null: limits.rateLimitPerMinute).
  rateLimitPerMinute Int?
  /// Render and preview jobs per UTC day / month (null: unlimited).
  rendersPerDay      Int?
  rendersPerMonth    Int?
  /// JSON array of CIDR blocks the key may be used from (null: anywhere).
  ipAllowlist        String?
  /// Highest job priority the key may use: interactive | standard | batch (null: each job type's default; D-103).
  maxPriority        String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([prefix])
  @@index([prevPrefix])
}

model Job {
  id          String    @id
  workspaceId String
  type        String
  /// queued | running | succeeded | failed | cancelled
  status      String
  projectId   String?
  params      String
  progress    String
  result      String?
  error       String?
  retryOf     String?
  /// The API key that started the job (render quotas, #65).
  apiKeyId    String?
  createdAt   DateTime
  startedAt   DateTime?
  finishedAt  DateTime?
  /// "database" for jobs of the database queue (#36, D-075); null for in-process jobs.
  queue             String?
  /// Database queue: claims so far (a crashed worker's job is claimed again until queue.maxAttempts).
  attempts          Int       @default(0)
  /// Database queue: the worker instance holding the job.
  workerId          String?
  /// Database queue: the claim is the worker's until then; renewed by its heartbeat.
  leaseExpiresAt    DateTime?
  /// cancel_job on another instance: the holding worker stops the job at its next heartbeat.
  cancelRequestedAt DateTime?
  /// Render fan-out (#156, D-097): the render a render_unit or render_join belongs to.
  parentId          String?
  /// Render fan-out, on the parent: units still to succeed; the unit taking it to 0 inserts the join.
  pendingChildren   Int?
  /// Render and preview jobs: the run id of the render they produce (params.runId), so get_render finds its project
  /// with one indexed read instead of a scan (#184).
  runId             String?
  /// Claim class (D-103): 0 interactive, 1 standard, 2 batch. The claim orders by it, then fairness, then age.
  priority          Int       @default(1)

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  events    JobEvent[]

  @@index([workspaceId, createdAt])
  @@index([workspaceId, projectId])
  /// Keyset pages of list_jobs, all and per project (D-102).
  @@index([workspaceId, createdAt, id])
  @@index([workspaceId, projectId, createdAt, id])
  @@index([status])
  @@index([workspaceId, apiKeyId, createdAt])
  @@index([workspaceId, queue, status, createdAt])
  /// The claim order (D-103) and the admission count: queued jobs of one queue by class, oldest first.
  @@index([workspaceId, queue, status, priority, createdAt])
  /// The claim plan's skip scan (#307, D-1XX): the distinct keys with queued jobs, each (key, class)'s oldest job,
  /// a key's running jobs, and the lock of one job of a (key, class) in age order, all without reading every queued job.
  /// No id column: MySQL's 3 072-byte key limit (four 191-character keys fill it), and InnoDB appends the primary key anyway.
  @@index([workspaceId, queue, status, apiKeyId, priority, createdAt], map: "Job_claim_idx")
  @@index([status, leaseExpiresAt])
  @@index([parentId])
  @@index([workspaceId, runId])
}

/// Status changes and log lines of a job, in order (id is monotonic).
model JobEvent {
  id          Int      @id @default(autoincrement())
  workspaceId String
  jobId       String
  at          DateTime
  /// "status" (message = new status) or "log" (message = the line)
  type        String
  message     String

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, id])
}

/// Operator/agent themes (built-in themes live in code).
model Theme {
  workspaceId String
  id          String
  definition  String
  createdAt   DateTime
  updatedAt   DateTime

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, id])
}

/// Provider settings set through the API (e.g. ELEVENLABS_API_KEY). Values are
/// never returned by the API. `scheme` says how `value` is stored: "aes-256-gcm"
/// (REELFORGE_SECRET_KEY, D-031) or "plain" (v0.1 imports and rows written
/// before encryption; encrypted at start once the key is set).
model ProviderSetting {
  workspaceId String
  name        String
  providerId  String?
  value       String
  scheme      String   @default("plain")
  updatedAt   DateTime

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, name])
}

/// Runtime configuration set over REST/MCP (update_config, D-029/D-031), by
/// dotted key (e.g. "limits.rateLimitPerMinute"). `value` is JSON text; for
/// secrets it is encrypted ("aes-256-gcm"). Highest precedence: overrides the
/// config file and environment variables. Instance-wide settings are stored in
/// the default workspace.
model Setting {
  workspaceId String
  key         String
  value       String
  scheme      String   @default("plain")
  updatedAt   DateTime
  updatedBy   String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, key])
}

/// Asset metadata. The bytes are in the storage driver at storageKey.
model Asset {
  workspaceId     String
  id              String
  sha256          String
  bytes           BigInt
  contentType     String
  mediaType       String
  storageKey      String
  source          String
  originalName    String?
  license         String?
  durationSeconds Float?
  metadata        String?
  createdAt       DateTime

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, id])
  @@index([workspaceId, createdAt])
  /// Keyset pages of list_assets (D-102).
  @@index([workspaceId, createdAt, id])
}

/// Audit trail (#65, D-055): append-only, one row per admin or write action.
/// Rows are only ever inserted, and deleted by the retention sweep
/// (audit.retentionDays). Never holds secret values.
model AuditLog {
  id          String   @id
  workspaceId String
  at          DateTime
  /// "api_key" | "cli" | "system"
  actorType   String
  actorId     String?
  /// The key's name at the time of the action.
  actorName   String?
  action      String
  targetType  String?
  targetId    String?
  /// "success" | "failure" | "denied"
  result      String   @default("success")
  ip          String?
  userAgent   String?
  requestId   String?
  data        String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, at])
  @@index([workspaceId, action, at])
  @@index([workspaceId, actorId, at])
}

/// Idempotency keys (#65, D-057): the stored result of a create or render call
/// made with an Idempotency-Key header (REST) or idempotencyKey argument (MCP),
/// per API key. Kept until expiresAt (24 h), then swept.
model IdempotencyKey {
  workspaceId String
  /// The API key (or "cli") that sent it: keys of different callers never collide.
  actorId     String
  key         String
  /// The operation (MCP tool name, e.g. "render_project").
  operation   String
  /// SHA-256 of the operation and its canonical arguments.
  requestHash String
  /// "pending" while the first call runs, then "done".
  status      String
  /// The result as JSON text (never a secret: calls that return one are not idempotent).
  response    String?
  createdAt   DateTime
  expiresAt   DateTime

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, actorId, key])
  @@index([workspaceId, expiresAt])
}

/// Per-key request counters for the shared rate limit (limits.rateLimitStore
/// "database", #36, D-078): one row per API key and minute, incremented
/// atomically by every instance; old windows are swept.
model RateLimitWindow {
  workspaceId String
  key         String
  windowStart DateTime
  count       Int

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, key, windowStart])
  @@index([windowStart])
}

/// Licence activation state (#25, D-028, D-035): one row per workspace (the
/// instance-wide licence lives in the default workspace). instanceId is random,
/// created once, and is the only thing sent to BuildBase besides the key. The
/// key itself is never stored here (it is the encrypted runtime setting
/// licence.key, or comes from the config file / environment); keyHash
/// (HMAC-SHA256 with the instance id) tells whether the stored answer is for
/// the key configured now.
model LicenceState {
  workspaceId   String    @id
  instanceId    String
  keyHash       String?
  /// The last answer from BuildBase (valid, reason, key status, item, instance) as JSON text.
  answer        String?
  /// Last attempt, successful or not.
  lastCheckedAt DateTime?
  /// Last time BuildBase answered valid: the offline grace period counts from here.
  lastSuccessAt DateTime?
  /// The last failed attempt (unreachable, rate limited, server error) as JSON text; null after a success.
  lastError     String?
  activatedAt   DateTime?
  /// Set by deactivate_licence: the server does not activate this key again by itself.
  deactivatedAt DateTime?
  nextCheckAt   DateTime?
  /// The latest clock time this server has seen (a clock set back cannot extend the grace period).
  highWaterAt   DateTime?
  updatedAt     DateTime

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// Instance-wide state (e.g. that the v0.1 filesystem import ran).
model SystemState {
  key       String   @id
  value     String
  updatedAt DateTime
}

/// An outbound event endpoint (#66, D-070): a signed webhook, a Slack/Discord/Teams
/// incoming webhook, or an email channel. url and the signing secrets are sealed
/// with the config cipher (REELFORGE_SECRET_KEY, AES-256-GCM); *Scheme says how.
model WebhookEndpoint {
  id                  String    @id
  workspaceId         String
  name                String
  description         String?
  /// "webhook" | "slack" | "discord" | "teams" | "email"
  type                String
  url                 String?
  urlScheme           String?
  /// The URL with its secret parts masked (lists).
  urlDisplay          String?
  /// Email channels: { provider, to } as JSON text.
  email               String?
  /// Event types and patterns as a JSON array.
  events              String
  enabled             Boolean   @default(true)
  disabledReason      String?
  secret              String?
  secretScheme        String?
  prevSecret          String?
  prevSecretScheme    String?
  prevSecretExpiresAt DateTime?
  createdAt           DateTime
  updatedAt           DateTime
  createdBy           String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

/// The outbox (#66, D-071): one message to one endpoint and its delivery state.
/// messageId is the webhook-id header: the same on every retry and replay.
model WebhookDelivery {
  id            String    @id
  workspaceId   String
  endpointId    String
  messageId     String
  eventId       String
  eventType     String
  /// The envelope's dedupeKey (`render:<jobId>` on terminal render events, #306); resend_webhook looks outcomes up by it.
  dedupeKey     String?
  /// The event envelope as JSON text (what is sent).
  payload       String
  /// "pending" | "delivering" | "succeeded" | "dead"
  status        String
  attempts      Int       @default(0)
  nextAttemptAt DateTime
  /// While delivering: the worker's lease (crash recovery picks the row up after it).
  lockedUntil   DateTime?
  lastStatus    Int?
  lastError     String?
  deliveredAt   DateTime?
  replayOf      String?
  createdAt     DateTime
  updatedAt     DateTime

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, nextAttemptAt])
  @@index([workspaceId, endpointId, id])
  @@index([workspaceId, status, updatedAt])
  @@index([workspaceId, eventId])
  @@index([workspaceId, dedupeKey])
}

/// The delivery log (#66): one row per attempt, append-only (removed only by retention with its delivery).
model WebhookAttempt {
  id          String   @id
  workspaceId String
  deliveryId  String
  endpointId  String
  attempt     Int
  at          DateTime
  durationMs  Int
  status      Int?
  error       String?
  /// "success" | "retry" | "failed"
  outcome     String

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, deliveryId])
}

/// Queue dispatch outbox (#158, D-105): one row per job that became claimable,
/// written in the same transaction as the job, for dispatch drivers that publish
/// to an external broker (SQS, Redis Streams, NATS JetStream: follow-ups). A
/// relay claims due rows with a lease, publishes the job ids and deletes the
/// rows; a failed publish is retried with backoff. `notify` does not use it
/// (its NOTIFY is part of the job's own transaction). The Job table stays the
/// record: a row lost here only delays a job until the workers' fallback poll.
model DispatchOutbox {
  id            String    @id
  workspaceId   String
  jobId         String
  attempts      Int       @default(0)
  nextAttemptAt DateTime
  /// While a relay publishes: its lease (a crashed relay's rows are picked up after it).
  lockedUntil   DateTime?
  lastError     String?
  createdAt     DateTime

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, nextAttemptAt])
}

/// A named lease that one instance of the deployment holds at a time (#195,
/// D-106). `queue-housekeeping`: its holder re-queues jobs whose lease expired
/// and counts the queue for every instance, and stores that count in `value`
/// where the others read it. Taken and renewed with one compare-and-set UPDATE
/// (free, expired, or already the holder's), so a dead holder's lease is taken
/// over once `expiresAt` passes.
model InstanceLease {
  workspaceId String
  name        String
  holder      String
  expiresAt   DateTime
  /// A number the holder publishes for the other instances (queue-housekeeping: queued jobs).
  value       Int?
  updatedAt   DateTime

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, name])
}
