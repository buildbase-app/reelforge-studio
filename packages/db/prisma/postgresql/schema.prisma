// GENERATED from prisma/base.prisma for postgresql. Do not edit; run `pnpm --filter @reelforge/db schemas`.
generator client {
  provider     = "prisma-client"
  output       = "../../src/generated/postgresql"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

model Workspace {
  id        String   @id
  name      String
  createdAt DateTime @default(now())

  projects         Project[]
  apiKeys          ApiKey[]
  jobs             Job[]
  themes           Theme[]
  providerSettings ProviderSetting[]
  settings         Setting[]
  assets           Asset[]
  auditLogs        AuditLog[]
  licenceStates    LicenceState[]
  idempotencyKeys  IdempotencyKey[]
}

/// A project; its manifests live in ProjectVersion (one row per saved version).
model Project {
  workspaceId String
  id          String
  /// Current version; bumped in the same transaction that inserts the ProjectVersion.
  version     Int
  title       String
  createdAt   DateTime
  updatedAt   DateTime

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions  ProjectVersion[]

  @@id([workspaceId, id])
  @@index([workspaceId, updatedAt])
}

model ProjectVersion {
  workspaceId String
  projectId   String
  version     Int
  /// The manifest (latest schema version) as JSON text.
  manifest    String
  createdAt   DateTime

  project Project @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade)

  @@id([workspaceId, projectId, version])
}

/// API keys: salted SHA-256 hashes only; the key itself is never stored.
/// Lifecycle (#65, D-055): optional expiry, rotation with a grace window for
/// the previous secret, revocation (the row stays for the audit trail),
/// per-key rate limit, render quotas and IP allowlist.
model ApiKey {
  id                 String    @id
  workspaceId        String
  name               String
  /// JSON array of scopes.
  scopes             String
  /// First characters of the key (lookup index; not secret on its own).
  prefix             String
  salt               String
  hash               String
  createdAt          DateTime
  lastUsedAt         DateTime?
  /// The key stops working after this time (null: never expires).
  expiresAt          DateTime?
  /// Revoked keys never authenticate again; the row stays for the audit trail.
  revokedAt          DateTime?
  /// The secret before the last rotation: prefix, salt and hash, valid until prevExpiresAt.
  prevPrefix         String?
  prevSalt           String?
  prevHash           String?
  prevExpiresAt      DateTime?
  rotatedAt          DateTime?
  /// Requests per minute for this key (null: limits.rateLimitPerMinute).
  rateLimitPerMinute Int?
  /// Render and preview jobs per UTC day / month (null: unlimited).
  rendersPerDay      Int?
  rendersPerMonth    Int?
  /// JSON array of CIDR blocks the key may be used from (null: anywhere).
  ipAllowlist        String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([prefix])
  @@index([prevPrefix])
}

model Job {
  id          String    @id
  workspaceId String
  type        String
  /// queued | running | succeeded | failed | cancelled
  status      String
  projectId   String?
  params      String
  progress    String
  result      String?
  error       String?
  retryOf     String?
  /// The API key that started the job (render quotas, #65).
  apiKeyId    String?
  createdAt   DateTime
  startedAt   DateTime?
  finishedAt  DateTime?

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  events    JobEvent[]

  @@index([workspaceId, createdAt])
  @@index([workspaceId, projectId])
  @@index([status])
  @@index([workspaceId, apiKeyId, createdAt])
}

/// Status changes and log lines of a job, in order (id is monotonic).
model JobEvent {
  id          Int      @id @default(autoincrement())
  workspaceId String
  jobId       String
  at          DateTime
  /// "status" (message = new status) or "log" (message = the line)
  type        String
  message     String

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, id])
}

/// Operator/agent themes (built-in themes live in code).
model Theme {
  workspaceId String
  id          String
  definition  String
  createdAt   DateTime
  updatedAt   DateTime

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, id])
}

/// Provider settings set through the API (e.g. ELEVENLABS_API_KEY). Values are
/// never returned by the API. `scheme` says how `value` is stored: "aes-256-gcm"
/// (REELFORGE_SECRET_KEY, D-031) or "plain" (v0.1 imports and rows written
/// before encryption; encrypted at start once the key is set).
model ProviderSetting {
  workspaceId String
  name        String
  providerId  String?
  value       String
  scheme      String   @default("plain")
  updatedAt   DateTime

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, name])
}

/// Runtime configuration set over REST/MCP (update_config, D-029/D-031), by
/// dotted key (e.g. "limits.rateLimitPerMinute"). `value` is JSON text; for
/// secrets it is encrypted ("aes-256-gcm"). Highest precedence: overrides the
/// config file and environment variables. Instance-wide settings are stored in
/// the default workspace.
model Setting {
  workspaceId String
  key         String
  value       String
  scheme      String   @default("plain")
  updatedAt   DateTime
  updatedBy   String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, key])
}

/// Asset metadata. The bytes are in the storage driver at storageKey.
model Asset {
  workspaceId     String
  id              String
  sha256          String
  bytes           BigInt
  contentType     String
  mediaType       String
  storageKey      String
  source          String
  originalName    String?
  license         String?
  durationSeconds Float?
  metadata        String?
  createdAt       DateTime

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, id])
  @@index([workspaceId, createdAt])
}

/// Audit trail (#65, D-055): append-only, one row per admin or write action.
/// Rows are only ever inserted, and deleted by the retention sweep
/// (audit.retentionDays). Never holds secret values.
model AuditLog {
  id          String   @id
  workspaceId String
  at          DateTime
  /// "api_key" | "cli" | "system"
  actorType   String
  actorId     String?
  /// The key's name at the time of the action.
  actorName   String?
  action      String
  targetType  String?
  targetId    String?
  /// "success" | "failure" | "denied"
  result      String   @default("success")
  ip          String?
  userAgent   String?
  requestId   String?
  data        String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, at])
  @@index([workspaceId, action, at])
  @@index([workspaceId, actorId, at])
}

/// Idempotency keys (#65, D-057): the stored result of a create or render call
/// made with an Idempotency-Key header (REST) or idempotencyKey argument (MCP),
/// per API key. Kept until expiresAt (24 h), then swept.
model IdempotencyKey {
  workspaceId String
  /// The API key (or "cli") that sent it: keys of different callers never collide.
  actorId     String
  key         String
  /// The operation (MCP tool name, e.g. "render_project").
  operation   String
  /// SHA-256 of the operation and its canonical arguments.
  requestHash String
  /// "pending" while the first call runs, then "done".
  status      String
  /// The result as JSON text (never a secret: calls that return one are not idempotent).
  response    String?
  createdAt   DateTime
  expiresAt   DateTime

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, actorId, key])
  @@index([workspaceId, expiresAt])
}

/// Licence activation state (#25, D-028, D-035): one row per workspace (the
/// instance-wide licence lives in the default workspace). instanceId is random,
/// created once, and is the only thing sent to BuildBase besides the key. The
/// key itself is never stored here (it is the encrypted runtime setting
/// licence.key, or comes from the config file / environment); keyHash
/// (HMAC-SHA256 with the instance id) tells whether the stored answer is for
/// the key configured now.
model LicenceState {
  workspaceId   String    @id
  instanceId    String
  keyHash       String?
  /// The last answer from BuildBase (valid, reason, key status, item, instance) as JSON text.
  answer        String?
  /// Last attempt, successful or not.
  lastCheckedAt DateTime?
  /// Last time BuildBase answered valid: the offline grace period counts from here.
  lastSuccessAt DateTime?
  /// The last failed attempt (unreachable, rate limited, server error) as JSON text; null after a success.
  lastError     String?
  activatedAt   DateTime?
  /// Set by deactivate_licence: the server does not activate this key again by itself.
  deactivatedAt DateTime?
  nextCheckAt   DateTime?
  /// The latest clock time this server has seen (a clock set back cannot extend the grace period).
  highWaterAt   DateTime?
  updatedAt     DateTime

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// Instance-wide state (e.g. that the v0.1 filesystem import ran).
model SystemState {
  key       String   @id
  value     String
  updatedAt DateTime
}
